# Leave empty to use Vite dev-server proxy (/api -> localhost:8080).
# Set to http://localhost:8080 for direct backend calls (e.g. production build preview).
VITE_API_URL=

# Full backend URL required for Google OAuth redirect (browser navigation, not axios).
VITE_OAUTH_BASE_URL=http://localhost:8080

# Razorpay Checkout public key (test-mode key by default so the app
# runs out of the box - swap for your live key_id before going live).
VITE_RAZORPAY_KEY_ID=rzp_test_TGeHLKQ6M4iovr
