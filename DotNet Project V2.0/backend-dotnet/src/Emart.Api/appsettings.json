{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "SingleLine": true
      }
    }
  },
  "AllowedHosts": "*",
  "Loyalty": {
    "EarnRate": 0.10
  },
  "SaleBootstrap": {
    "Enabled": true,
    "ProductCount": 3,
    "DiscountPercent": 25,
    "DurationHours": 48
  },
  "PriceRounding": {
    "Enabled": false
  },
  "Jwt": {
    "ExpirationHours": 24
  },
  "GoogleOAuth": {
    "RedirectUri": "http://localhost:5173/oauth2/redirect"
  },
  "Mail": {
    "Host": "smtp.gmail.com",
    "Port": 587
  }
}
