<!-- PDF invoice generation (BRD: "invoice should be sent to
     customer preferably in .PDF format"; WPT: "Email and PDF
     wherever needed"). OpenPDF is a permissively-licensed
     (LGPL/MPL), actively-maintained fork of the classic iText 2.x
     API - lightweight, no other project dependency touches it. -->
<dependency>
    <groupId>com.github.librepdf</groupId>
    <artifactId>openpdf</artifactId>
    <version>1.3.30</version>
</dependency>

<!-- Razorpay payment gateway (order creation + signature verification
     for the checkout flow's Pay step). -->
<dependency>
    <groupId>com.razorpay</groupId>
    <artifactId>razorpay-java</artifactId>
    <version>1.4.9</version>
</dependency>

<!-- Transactional email (registration welcome mail, order
     confirmation mail). -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-mail</artifactId>
</dependency>
	</dependencies>

